#!/usr/bin/bash
# Einstieg des Home-Prozesses. Der Supervisor (session/supervisor.py) startet diese Datei aus
# dem Release; tools/run-headless startet sie in Tests direkt.
#
# Rückgabewerte (Bauplan 3.3):  0 = Sitzung beenden   10 = Übergabe an Steam (<run>/handover.json)
#                               alles andere = Absturz bzw. Fehlstart
# Protokoll: <state>/home.log, wird ab 1 MiB rotiert (home.log.1 … .3). Auch ein Python, das
# gar nicht erst startet, landet damit im Protokoll.
# COUCH_LOG_STDERR=1 lässt die Ausgabe stattdessen auf dem Terminal.

here="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"     # <release>/app
release="$(dirname "$here")"
cd "$release" || exit 70

# E104: "couch-home --check [--json]" prüft nur, ob die Laufzeit da ist (app/couch/depcheck.py), mit
# demselben Python wie das Home. Startet nichts, legt nichts an: geht auch ohne Prüfordner und Sitzung.
if [[ "${1:-}" == --check ]]; then
  py="${COUCH_PYTHON:-}"
  if [[ -z "$py" ]]; then
    if [[ -x /usr/bin/python3 ]]; then py=/usr/bin/python3; else py=python3; fi
  fi
  exec "$py" -I "$here/couch/depcheck.py" "${@:2}"
  case "${LC_ALL:-${LC_MESSAGES:-${LANG:-}}}" in
    en*) echo "couch-home: Python cannot be run: $py" >&2 ;;
    *)   echo "couch-home: Python nicht ausführbar: $py" >&2 ;;
  esac
  exit 1
fi

# Prüfmodus ohne Prüfordner: Alle Orte zeigten auf die echten Ordner des Nutzers, und nicht jeder Schreibweg
# wäre abgeschaltet. Dann lieber gar nicht starten (noch bevor hier etwas angelegt wird).
if [[ "${COUCH_TEST:-}" == 1 && -z "${COUCH_TEST_ROOT:-}" ]]; then
  echo "couch-home: COUCH_TEST=1 ohne COUCH_TEST_ROOT. Der Prüfmodus braucht seinen Ordner; nichts gestartet." >&2
  exit 2
fi

if [[ -n "${COUCH_TEST_ROOT:-}" ]]; then
  state="$COUCH_TEST_ROOT/state"
else
  state="$HOME/.local/state/couch"
fi

# Das Python des Systems wie in session/couch-session, nicht irgendeins weiter vorn im PATH
# (~/.local/bin, Homebrew): Dem fehlten GTK und WebKit, und das Home stürzte gleich beim Start ab
py="${COUCH_PYTHON:-}"
if [[ -z "$py" ]]; then
  if [[ -x /usr/bin/python3 ]]; then py=/usr/bin/python3; else py=python3; fi
fi

# WebKit taktet seine Bilder mit einem Zeitgeber (60 Hz) statt über den Bildwechsel eines DRM-
# Ausgangs. Sonst merkt sich WebKit beim Start den Ausgang, den Gamescope gerade benutzt; schaltet
# Gamescope danach den Fernseher um (HDR an, Ausgang kurz weg und wieder da), liefert dieser keinen
# Takt mehr, WebKit schläft ersatzweise 500 ms je Bild: das Home lief mit 2 fps (2026-10-14/15 am
# Fernseher gemessen, eu-stack: DisplayVBlankMonitorDRM::waitForVBlank in nanosleep). Gamescope
# stimmt die Bilder ohnehin selbst mit dem Fernseher ab.
export WEBKIT_FORCE_VBLANK_TIMER=1
# Gamescopes Vulkan-Schicht (WSI) ist für Spiele da, nicht für die Oberfläche. Apps, die das Home
# startet, bekommen beides nicht mit: proc/manager.py nimmt die Variablen aus ihrer Umgebung.
export DISABLE_GAMESCOPE_WSI=1

# Grafik-Versuche ohne neues Release: ~/.config/couch/home.env, je Zeile NAME=WERT. Nur Namen aus
# dieser Liste, nichts wird ausgeführt. Gilt ab dem nächsten Start des Home (der Supervisor startet es
# nach einem Absturz neu, ohne die Sitzung zu beenden).
if [[ -z "${COUCH_TEST_ROOT:-}" && -r "$HOME/.config/couch/home.env" ]]; then
  while IFS= read -r line || [[ -n "$line" ]]; do
    name="${line%%=*}"; value="${line#*=}"
    [[ "$line" == *=* ]] || continue
    case "$name" in
      GSK_RENDERER|GSK_DEBUG|GDK_DEBUG|GDK_DISABLE|GDK_GL_DISABLE|GDK_VULKAN_DISABLE|DISABLE_GAMESCOPE_WSI|ENABLE_GAMESCOPE_WSI \
      |MESA_VK_WSI_PRESENT_MODE|vk_xwayland_wait_ready|vk_x11_strict_image_count|vk_x11_override_min_image_count \
      |mesa_glthread|WEBKIT_SHOW_FPS|WEBKIT_FORCE_VBLANK_TIMER|WEBKIT_DISABLE_DMABUF_RENDERER|WEBKIT_DISABLE_COMPOSITING_MODE|WEBKIT_SKIA_ENABLE_CPU_RENDERING)
        if [[ -z "$value" ]]; then unset "$name"; else export "$name=$value"; fi
        echo "couch-home: Versuch aus home.env: $name=${value:-(entfernt)}" >&2 ;;
    esac
  done < "$HOME/.config/couch/home.env"
fi

# Nur der eigene Baum; PYTHONPATH aus der Sitzung könnte fremde Module vor unsere schieben
export PYTHONPATH="$here"
unset PYTHONHOME PYTHONSTARTUP

if [[ "${COUCH_LOG_STDERR:-}" != 1 ]]; then
  mkdir -p "$state" 2>/dev/null
  log="$state/home.log"
  size=$(stat -c %s "$log" 2>/dev/null || echo 0)
  if (( size > 1048576 )); then
    mv -f "$log.2" "$log.3" 2>/dev/null
    mv -f "$log.1" "$log.2" 2>/dev/null
    mv -f "$log" "$log.1" 2>/dev/null
  fi
  # Ist der Zustandsordner nicht beschreibbar (Platte voll), startet das Home trotzdem
  if { : >>"$log"; } 2>/dev/null; then
    export COUCH_LOG_FILE="$log"
    exec "$py" -m couch "$@" >>"$log" 2>&1
  fi
fi
exec "$py" -m couch "$@"
